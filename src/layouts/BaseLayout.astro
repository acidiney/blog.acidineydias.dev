---
import SearchDialog from '../components/SearchDialog.vue';
import type { BlogImageSource } from '../lib/content';
import { SITE_COPYRIGHT } from '../lib/content';
import '../styles/global.css';

interface Props { title: string; description: string; canonical?: string; image?: string; type?: 'website' | 'article'; noindex?: boolean; language?: 'pt' | 'en'; preloadImage?: BlogImageSource; }
const { title, description, canonical = Astro.url.pathname, image = '/assets/img/logo.jpeg', type = 'website', noindex = false, language = 'pt', preloadImage } = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site);
const imageUrl = new URL(image, Astro.site);
const fullTitle = title === 'Acidiney Dias' ? title : `${title} — Acidiney Dias`;
const gaId = import.meta.env.PUBLIC_GA_ID;
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="Acidiney Dias" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" type="application/rss+xml" title="Artigos de Acidiney Dias" href="/blog/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Poemas de Acidiney Dias" href="/poems/rss.xml" />
    <link rel="icon" href="/assets/favicons/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/favicons/apple-touch-icon.png" />
    <meta name="theme-color" content="#212121" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage.src} imagesrcset={preloadImage.srcset} imagesizes="(max-width: 1092px) calc(100vw - 2rem), 1060px" fetchpriority="high" />}
    {gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
    {gaId && <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date()); gtag('config', gaId);
    </script>}
  </head>
  <body>
    <a class="skip-link" href="#content">Saltar para o conteúdo</a>
    <header class="site-header" data-testid="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href="/">Acidiney Dias</a>
        <nav class="nav" aria-label="Navegação principal">
          <a href="/blog/">Artigos</a><a href="/poems/">Poemas</a><a href="/blog/tags/">Tags</a>
        </nav>
        <SearchDialog client:idle={{ timeout: 800 }} />
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="footer"><div class="shell footer__inner"><span>Ideias, código e vida em curso.</span><span>© {SITE_COPYRIGHT} Acidiney Dias · <a href="/blog/rss.xml">RSS</a></span></div></footer>
  </body>
</html>
