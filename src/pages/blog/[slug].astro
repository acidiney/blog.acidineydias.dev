---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
export async function getStaticPaths() { return (await getCollection('blog')).map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
---
<BlogPostLayout post={post} headings={headings}><Content /></BlogPostLayout>
